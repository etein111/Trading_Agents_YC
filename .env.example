# MiniMax API (used as default LLM provider in TradingAgents)
MINIMAX_API_KEY=

# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# Gmail Configuration for email reports
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Portfolio file location
PORTFOLIO_FILE=data/portfolio.json

# Scheduler log location
SCHEDULER_LOG=logs/scheduler.log

# Scheduler task queue location
TASK_QUEUE_FILE=data/task_queue.json

# ===== Analysis Defaults (optional, CLI falls back to interactive prompt if unset) =====
# Stock ticker to analyze
# TICKER=AMZN

# Analysis interval: 1w=1 week, 1m=1 month, 3m=3 months from today
# Or a specific date: 2026-05-10
# Or a date range: 2026-05-01,2026-05-10 (start,end)
# ANALYSIS_INTERVAL=1w

# Comma-separated analyst keys: market, social, news, fundamentals
# ANALYSTS=market,social,news,fundamentals

# Research depth (debate rounds): 1, 2, or 3
# RESEARCH_DEPTH=1

# Output language
# OUTPUT_LANGUAGE=English
